{
  "name": "budzet-domowy",
  "private": true,
  "description": "Budżet domowy – statyczna aplikacja (HTML + JS) z bazą Supabase",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css --watch",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "papaparse": "5.4.1",
    "tailwindcss": "3.4.17"
  }
}
